EguiUi = (
    | handle |

    handle = ( ^handle )
    handle: h = ( handle := h. )

    painter = (
        | p |
        p := EguiPainter new.
        p handle: handle. "Pass the same native Ui pointer"
        ^p
    )

    label: text = primitive
    button: text = primitive
    textEdit: textRef = primitive
    textEditMultiline: textRef = primitive
    textEditReadonly: text = primitive

    horizontal: block = (
        self primHorizontal: [:nativePtr |
            | ui |
            ui := EguiUi new.
            ui handle: nativePtr.
            block value: ui
        ]
    )
    primHorizontal: block = primitive

    vertical: block = (
        self primVertical: [:nativePtr |
            | ui |
            ui := EguiUi new.
            ui handle: nativePtr.
            block value: ui
        ]
    )
    primVertical: block = primitive
    
    scrollArea: block = (
        self primScrollArea: [:nativePtr |
            | ui |
            ui := EguiUi new.
            ui handle: nativePtr.
            block value: ui
        ]
    )
    primScrollArea: block = primitive
    
    columns: count do: block = (
        self primColumns: count do: [:colsArray |
            block value: colsArray
        ]
    )
    primColumns: count do: block = primitive

    heading: text = primitive
    separator = primitive

    group: block = (
        self primGroup: [:nativePtr |
            | ui |
            ui := EguiUi new.
            ui handle: nativePtr.
            block value: ui
        ]
    )
    primGroup: block = primitive

    comboBoxSelected: selected options: options do: block = (
        self primComboBox: '' selected: selected options: options do: block
    )
    comboBox: label selected: selected options: options do: block = (
        self primComboBox: label selected: selected options: options do: block
    )
    primComboBox: label selected: selected options: options do: block = primitive
)
