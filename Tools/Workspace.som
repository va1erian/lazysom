Workspace = (
    | codeInput codeOutput runStatus ide lastTaskStatus |

    codeInput = ( ^codeInput )
    codeInput: val = ( codeInput := val. )

    ide: anIde = ( ide := anIde. )

    initialize = (
        codeInput := '"Write SOM code here. Click Evaluate to run asynchronously without blocking the UI.\nTry making a halt to trigger the Debugger, e.g.:"\n\n[ | x | \n  x := 42.\n  self halt.\n  x * 2\n] value'.
        codeOutput := ''.
        runStatus := 'idle'.
        lastTaskStatus := 'idle'.
    )

    renderOn: winUi = (
        "Docking Controls"
        winUi horizontal: [:row |
            row heading: 'Interactive Workspace'.
            row separator.
            (row button: 'Float') ifTrue: [ ide workspaceDock: 'float' ].
            (row button: 'Left') ifTrue: [ ide workspaceDock: 'left' ].
            (row button: 'Right') ifTrue: [ ide workspaceDock: 'right' ].
            (row button: 'Bottom') ifTrue: [ ide workspaceDock: 'bottom' ].
            (row button: 'Max') ifTrue: [ ide workspaceDock: 'fill' ].
        ].
        winUi separator.
        
        winUi label: 'Write SOM Code Snippet:'.
        winUi textEditMultiline: codeInput.

        "Poll active background task status"
        runStatus := system bgTaskStatus.

        runStatus = 'running' ifTrue: [
            | out |
            lastTaskStatus = 'running' ifFalse: [
                codeOutput := ''.
                lastTaskStatus := 'running'.
            ].
            out := system bgTaskOutput.
            out ifNotNil: [
                (out length > 0) ifTrue: [ codeOutput := codeOutput + out ].
            ].
        ].

        runStatus = 'completed' ifTrue: [
            lastTaskStatus = 'running' ifTrue: [
                | out res |
                out := system bgTaskOutput.
                out ifNotNil: [
                    (out length > 0) ifTrue: [ codeOutput := codeOutput + out ].
                ].
                res := system bgTaskResult.
                codeOutput := codeOutput + '\n---\nReturned: ' + res.
                lastTaskStatus := 'completed'.
            ].
        ].

        runStatus = 'errored' ifTrue: [
            lastTaskStatus = 'running' ifTrue: [
                | out err |
                out := system bgTaskOutput.
                out ifNotNil: [
                    (out length > 0) ifTrue: [ codeOutput := codeOutput + out ].
                ].
                err := system bgTaskError.
                codeOutput := codeOutput + '\n---\n⚠️ RUNTIME ERROR:\n' + err.
                lastTaskStatus := 'errored'.
            ].
        ].

        runStatus = 'idle' ifTrue: [
            lastTaskStatus := 'idle'.
        ].
        
        runStatus = 'paused' ifTrue: [
            lastTaskStatus := 'paused'.
        ].

        winUi horizontal: [:row |
            runStatus = 'running' ifTrue: [
                row label: '⚡ Running asynchronously in background VM...'.
                (row button: '🛑 Abort Execution') ifTrue: [
                    system bgTaskCommand: 'stop'.
                ].
            ] ifFalse: [
                runStatus = 'paused' ifTrue: [
                    row label: '⏸️ Paused at Breakpoint! Open the Debugger tab.'.
                    (row button: '🛑 Terminate') ifTrue: [
                        system bgTaskCommand: 'stop'.
                    ].
                ] ifFalse: [
                    (row button: '🚀 Run Snippet') ifTrue: [
                        system evaluateAsync: codeInput.
                        codeOutput := 'Evaluating...'.
                        lastTaskStatus := 'idle'. "Force resetting on start"
                    ].
                ].
            ].
        ].

        winUi separator.
        winUi heading: 'Result / Console Output'.

        winUi scrollArea: [:scroll |
            scroll textEditReadonly: codeOutput.
        ].
    )
)
